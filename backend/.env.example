# База данных SQLite.
DATABASE_URL=sqlite:///./trainer.db

# Разрешённые адреса frontend.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Для HTTPS установите true.
AUTH_COOKIE_SECURE=false

# Ключ и модель Groq для разбора кода.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Установите true, если используете бесплатный тариф Groq.
GROQ_FREE_PLAN_CONFIRMED=false
